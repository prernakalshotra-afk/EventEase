      "name": "Get Sent Reminders",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        272,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "rPlaNnXB3ruls7Rv",
          "name": "Google Sheets account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst participants = $('Get Participants').all().map(i => i.json).filter(p => p.participantId && p.email);\nconst alreadySent = new Set($('Get Sent Reminders').all().map(i => i.json.participantId).filter(Boolean));\nconst hoursLeft = Math.round((new Date(cfg.eventDate).getTime() - Date.now()) / 3600000);\n\n// Only remind people who have not received a reminder yet\nreturn participants\n  .filter(p => !alreadySent.has(p.participantId))\n  .map(p => ({ json: { ...p, hoursLeft } }));"
      },
      "id": "1b0bc297-54f1-42f8-9c2a-7b85fa839691",
      "name": "Prepare Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ 'Reminder: ' + $('Config').first().json.eventName + ' is coming up!' }}",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:560px\"><h2>See you soon! ⏰</h2><p>Hi {{ $json.fullName }},</p><p><b>{{ $('Config').first().json.eventName }}</b> starts in about <b>{{ $json.hoursLeft }} hours</b>.</p><ul><li><b>When:</b> {{ new Date($('Config').first().json.eventDate).toLocaleString('en-GB', { dateStyle: 'full', timeStyle: 'short' }) }}</li><li><b>Where:</b> {{ $('Config').first().json.eventVenue }}</li></ul><p>Please bring your <b>QR pass</b> (check your earlier email) for quick check-in.</p></div>",
        "options": {
          "appendAttribution": false
        }
      },
