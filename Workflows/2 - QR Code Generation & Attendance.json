    {
      "parameters": {
        "jsCode": "const req = $('Attendance Webhook').first().json.query || {};\nconst qr = $('Lookup QR Record').first().json || {};\nconst att = $('Check Attendance').first().json || {};\n\nlet outcome, message;\nif (!req.participantId || !req.token) {\n  outcome = 'INVALID_REQUEST'; message = 'The scan link is missing the participant ID or token.';\n} else if (!qr.participantId) {\n  outcome = 'INVALID_QR'; message = 'No registration was found for this QR code.';\n} else if (String(qr.token) !== String(req.token)) {\n  outcome = 'INVALID_QR'; message = 'This QR code is not valid (token mismatch).';\n} else if (att.attendanceId) {\n  outcome = 'ALREADY_MARKED'; message = 'Attendance was already recorded at ' + att.checkInTime + '.';\n} else {\n  outcome = 'SUCCESS'; message = 'Attendance recorded successfully.';\n}\n\nconst colors = { SUCCESS: '#16a34a', ALREADY_MARKED: '#d97706', INVALID_QR: '#dc2626', INVALID_REQUEST: '#dc2626' };\nconst titles = { SUCCESS: 'Check-in successful', ALREADY_MARKED: 'Already checked in', INVALID_QR: 'Invalid QR code', INVALID_REQUEST: 'Invalid request' };\nconst esc = s => String(s == null ? '' : s).replace(/[&<>\"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[ch]));\nconst who = qr.fullName ? '<p style=\"font-size:20px\"><b>' + esc(qr.fullName) + '</b><br><span style=\"color:#555\">' + esc(qr.participantId) + '</span></p>' : '';\nconst htmlResponse = '<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>' + titles[outcome] + '</title></head>'\n  + '<body style=\"font-family:Arial,sans-serif;text-align:center;padding:40px\"><div style=\"max-width:420px;margin:auto;border:3px solid ' + colors[outcome] + ';border-radius:16px;padding:32px\">'\n  + '<h1 style=\"color:' + colors[outcome] + '\">' + titles[outcome] + '</h1>' + who + '<p>' + esc(message) + '</p></div></body></html>';\n\nreturn [{ json: {\n  outcome, message, htmlResponse,\n  attendanceId: 'ATT-' + Date.now().toString(36).toUpperCase(),\n  participantId: qr.participantId || req.participantId || '',\n  eventId: qr.eventId || '',\n  fullName: qr.fullName || '',\n  email: qr.email || '',\n  checkInTime: new Date().toISOString()\n} }];"
      },
