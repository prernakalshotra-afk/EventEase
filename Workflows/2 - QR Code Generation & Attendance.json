      "parameters": {
        "jsCode": "const body = $('Generate QR Webhook').first().json.body || {};\nconst cfg = $('Config (QR)').first().json;\n\nif (!body.participantId || !body.email) {\n  throw new Error('Missing participantId or email in request body - cannot generate QR');\n}\n\nconst token = 'T' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);\nconst qrPayload = cfg.attendanceBaseUrl + '?participantId=' + encodeURIComponent(body.participantId) + '&token=' + token;\nconst qrImageUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&margin=10&data=' + encodeURIComponent(qrPayload);\n\nreturn [{ json: {\n  participantId: body.participantId,\n  eventId: body.eventId || '',\n  fullName: body.fullName || '',\n  email: body.email,\n  eventName: body.eventName || '',\n  eventDate: body.eventDate || '',\n  eventVenue: body.eventVenue || '',\n  token,\n  qrPayload,\n  qrImageUrl,\n  generatedAt: new Date().toISOString(),\n  status: 'ACTIVE'\n} }];"
      },
