      "parameters": {
        "jsCode": "const certs = $('Generate Certificates').all();\n// Drive upload returns JSON only, so we re-attach the certificate file from the earlier node\nreturn $input.all().map((item, i) => ({\n  json: {\n    ...certs[i].json,\n    driveFileId: item.json.id || '',\n    driveLink: item.json.id ? 'https://drive.google.com/file/d/' + item.json.id + '/view' : ''\n  },\n  binary: certs[i].binary\n}));"
      },
