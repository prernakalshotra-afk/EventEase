    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst people = $('Check Eligibility').all().map(i => i.json);\nconst esc = s => String(s == null ? '' : s).replace(/[&<>\"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[ch]));\nconst fmt = d => new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });\nconst eventDateStr = fmt(cfg.eventDate);\nconst issueDateStr = fmt(new Date());\nconst out = [];\n\nfor (const p of people) {\n  const certificateId = 'CERT-' + String(p.participantId).replace('PID-', '');\n  const html = `<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Certificate ${esc(certificateId)}</title>\n<style>@page{size:A4 landscape;margin:0}body{margin:0;font-family:Georgia,serif;background:#fff}\n.wrap{width:1050px;height:720px;margin:20px auto;border:14px double #1e3a8a;padding:40px;box-sizing:border-box;text-align:center;position:relative}\nh1{font-size:54px;color:#1e3a8a;margin:30px 0 6px;letter-spacing:4px}p{font-size:22px;color:#333;margin:10px 0}\n.name{font-size:44px;margin:26px 0;border-bottom:2px solid #999;display:inline-block;padding:0 40px}\n.foot{position:absolute;bottom:36px;left:0;right:0;font-size:15px;color:#666}</style></head>\n<body><div class=\"wrap\"><h1>CERTIFICATE</h1><p>OF PARTICIPATION</p><p>This is to certify that</p>\n<div class=\"name\">${esc(p.fullName)}</div><p>has successfully attended</p>\n<p style=\"font-size:30px\"><b>${esc(cfg.eventName)}</b></p>\n<p>held on ${esc(eventDateStr)} at ${esc(cfg.eventVenue)}</p>\n<div class=\"foot\">Certificate ID: ${esc(certificateId)} &nbsp;|&nbsp; Issued: ${esc(issueDateStr)} &nbsp;|&nbsp; Participant ID: ${esc(p.participantId)}</div>\n</div></body></html>`;\n  const fileName = certificateId + '.html';\n  const bin = await this.helpers.prepareBinaryData(Buffer.from(html, 'utf8'), fileName, 'text/html');\n  out.push({ json: { ...p, certificateId, fileName, issuedAt: new Date().toISOString() }, binary: { data: bin } });\n}\nreturn out;"
      },
