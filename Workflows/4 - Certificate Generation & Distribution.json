      "position": [
        880,
        32
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "YOUR_EMAIL",
        "subject": "={{ 'Approval needed: issue ' + $('Check Eligibility').all().length + ' certificate(s) for ' + $('Config').first().json.eventName }}",
        "message": "=<p>Hello,</p><p><b>{{ $('Check Eligibility').all().length }}</b> participant(s) attended <b>{{ $('Config').first().json.eventName }}</b> and are eligible for a certificate:</p><p>{{ $('Check Eligibility').all().slice(0, 25).map(i => i.json.fullName).join(', ') }}{{ $('Check Eligibility').all().length > 25 ? ' ...' : '' }}</p><p>Approve to generate and email the certificates, or reject to cancel.</p>",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "disapproveLabel": "Reject"
          }
        },
        "options": {}
