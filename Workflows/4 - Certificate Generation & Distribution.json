    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst attended = $('Get Attendance').all().map(i => i.json);\n\nreturn attended.map(a => ({\n  json: {\n    participantId: a.participantId || \"12345\",\n    fullName: a.fullName || \"Prerna Kalshotra\",\n    email: a.email || \"prerna.kalshotra2@gmail.com\",\n    eventId: cfg.eventId || \"EVT-2026-001\",\n    checkInTime: a.checkInTime || \"Today\"\n  }\n}));"
      },
      "id": "0faff11f-0f2a-42d6-af00-a889a0d2b264",
      "name": "Check Eligibility",
      "type": "n8n-nodes-base.code",
