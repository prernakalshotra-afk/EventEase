    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst errors = [];\nconst name = (item.fullName || '').toString().trim();\nconst email = (item.email || '').toString().trim().toLowerCase();\nconst phoneDigits = (item.phone || '').toString().replace(/[\\s\\-()+]/g, '');\n\nif (name.length < 2) errors.push('Full name is missing or too short');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('Email is missing or invalid');\nif (phoneDigits && !/^\\d{7,15}$/.test(phoneDigits)) errors.push('Phone must contain 7-15 digits');\n\nreturn [{ json: { ...item, fullName: name, email, valid: errors.length === 0, errors, validatedAt: new Date().toISOString() } }];"
      },
